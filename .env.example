# Server Configuration
PORT=3000

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Database schema synchronization (set to "true" for dev, "false" for prod)
DB_SYNCHRONIZE="false"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID="bizzdeal-e82c6"
FIREBASE_CLIENT_EMAIL="your_firebase_client_email_here"
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"
FIREBASE_STORAGE_BUCKET="bizzdeal-e82c6.firebasestorage.app"

# Frontend Configuration
FRONTEND_URL="http://localhost:4200"

# Rate Limiting Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_UPLOAD_TTL=60000
THROTTLE_UPLOAD_LIMIT=10

