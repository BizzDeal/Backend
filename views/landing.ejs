<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to BizzDeal</title>
  <link rel="icon" type="image/png" href="/assets/icon-only1.png">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #1565C0;
      --primary-light: #2196F3;
      --primary-gradient: linear-gradient(135deg, #0D47A1 0%, #1976D2 50%, #42A5F5 100%);
      --bg-dark: #0B1120;
      --card-bg: rgba(255, 255, 255, 0.05);
      --card-border: rgba(255, 255, 255, 0.1);
      --text-white: #FFFFFF;
      --text-muted: #94A3B8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(at 0% 0%, rgba(21, 101, 192, 0.3) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(33, 150, 243, 0.2) 0px, transparent 50%),
        radial-gradient(at 50% 50%, rgba(13, 71, 161, 0.15) 0px, transparent 60%);
      min-height: 100vh;
      color: var(--text-white);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      overflow-x: hidden;
      padding: 40px 20px 24px;
    }

    .main-container {
      max-width: 720px;
      width: 100%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: auto 0;
    }

    .icon-badge {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 12px 36px rgba(33, 150, 243, 0.35);
      margin-bottom: 24px;
      padding: 10px;
      animation: float 4s ease-in-out infinite;
    }

    .icon-badge img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    .brand-logo {
      max-width: 220px;
      height: auto;
      margin-bottom: 24px;
      filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
    }

    .tagline-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(33, 150, 243, 0.15);
      border: 1px solid rgba(33, 150, 243, 0.3);
      padding: 8px 18px;
      border-radius: 100px;
      color: #60A5FA;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 24px;
      backdrop-filter: blur(8px);
    }

    .tagline-badge .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #38BDF8;
      box-shadow: 0 0 10px #38BDF8;
    }

    h1 {
      font-family: 'Outfit', sans-serif;
      font-size: clamp(36px, 6vw, 56px);
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 18px;
      background: linear-gradient(135deg, #FFFFFF 30%, #93C5FD 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.02em;
    }

    p.subtitle {
      font-size: clamp(16px, 2.5vw, 19px);
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 580px;
      margin-bottom: 40px;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      width: 100%;
      margin-bottom: 40px;
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 18px;
      padding: 24px 20px;
      text-align: center;
      backdrop-filter: blur(12px);
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .card:hover {
      transform: translateY(-4px);
      border-color: rgba(33, 150, 243, 0.4);
    }

    .card-icon {
      font-size: 28px;
      margin-bottom: 12px;
      display: inline-block;
    }

    .card-title {
      font-family: 'Outfit', sans-serif;
      font-size: 17px;
      font-weight: 600;
      color: #F1F5F9;
      margin-bottom: 6px;
    }

    .card-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .app-cta {
      background: linear-gradient(135deg, rgba(21, 101, 192, 0.25) 0%, rgba(33, 150, 243, 0.15) 100%);
      border: 1px solid rgba(33, 150, 243, 0.35);
      border-radius: 20px;
      padding: 24px 32px;
      width: 100%;
      max-width: 540px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      backdrop-filter: blur(10px);
    }

    .app-cta h3 {
      font-family: 'Outfit', sans-serif;
      font-size: 18px;
      font-weight: 600;
      color: #E2E8F0;
    }

    .app-cta p {
      font-size: 14px;
      color: var(--text-muted);
    }

    footer {
      margin-top: 40px;
      text-align: center;
      font-size: 13px;
      color: #64748B;
    }
  </style>
</head>

<body>
  <main class="main-container">
    <!-- Globe Icon Badge -->
    <div class="icon-badge">
      <img src="/assets/icon-only1.png" alt="BizzDeal Icon">
    </div>

    <!-- Brand Logo Text -->
    <img src="/assets/logo-text.png" alt="BizzDeal" class="brand-logo">

    <div class="tagline-badge">
      <span class="dot"></span>
      <span>Empowering Local Business & Growth</span>
    </div>

    <!-- Main Title -->
    <h1>Welcome to BizzDeal</h1>

    <p class="subtitle">
      Connecting businesses, entrepreneurs, and customers through trusted referrals, exclusive deals, and smart rewards.
    </p>

    <!-- Highlights Grid -->
    <div class="cards-grid">
      <div class="card">
        <div class="card-icon">🤝</div>
        <div class="card-title">Trusted Referrals</div>
        <div class="card-desc">Expand your business network through structured member-to-member referral slips.</div>
      </div>
      <div class="card">
        <div class="card-icon">🏷️</div>
        <div class="card-title">Exclusive Deals</div>
        <div class="card-desc">Discover verified vouchers and high-value offers curated by local business owners.</div>
      </div>
      <div class="card">
        <div class="card-icon">🪙</div>
        <div class="card-title">BizzCoins Rewards</div>
        <div class="card-desc">Earn points and coins with every interaction, redeemable directly across merchants.</div>
      </div>
    </div>

    <!-- Mobile CTA -->
    <div class="app-cta">
      <h3>Available on Mobile</h3>
      <p>Download the BizzDeal app on Android and iOS to start connecting and saving today.</p>
    </div>
  </main>

  <footer>
    &copy; <%= new Date().getFullYear() %> BizzDeal. All rights reserved.
  </footer>
</body>

</html>
