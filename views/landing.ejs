  <script>
    function activateTab(tabType) {
      ['business', 'shopper'].forEach(type => {
        const suffix = type === 'business' ? 'Business' : 'Shopper';
        const button = document.getElementById('btnTab' + suffix);
        const panel = document.getElementById('tabContent' + suffix);
        const selected = type === tabType;
        button.classList.toggle('active', selected);
        button.setAttribute('aria-selected', String(selected));
        button.tabIndex = selected ? 0 : -1;
        panel.classList.toggle('active', selected);
        panel.hidden = !selected;
      });
    }

    const audienceTabs = [...document.querySelectorAll('[role="tab"]')];
    audienceTabs.forEach((tab, index) => {
      tab.addEventListener('keydown', event => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? 1 : 1 - index;
        activateTab(nextIndex === 0 ? 'business' : 'shopper');
        audienceTabs[nextIndex].focus();
      });
    });

    function toggleFaq(button) {
      const shouldOpen = button.getAttribute('aria-expanded') !== 'true';
      document.querySelectorAll('.faq-question').forEach(question => {
        const open = question === button && shouldOpen;
        question.setAttribute('aria-expanded', String(open));
        question.parentElement.classList.toggle('open', open);
        document.getElementById(question.getAttribute('aria-controls')).hidden = !open;
      });
    }

    const mobileMenuToggle = document.getElementById('mobileMenuToggle');
    const mobileDrawer = document.getElementById('mobileDrawer');
    const desktopBreakpoint = window.matchMedia('(min-width: 1101px)');

    function closeMobileMenu(returnFocus = false) {
      mobileDrawer.hidden = true;
      mobileMenuToggle.setAttribute('aria-expanded', 'false');
      mobileMenuToggle.setAttribute('aria-label', 'Open navigation');
      document.body.classList.remove('menu-open');
      if (returnFocus) mobileMenuToggle.focus();
    }

    mobileMenuToggle.addEventListener('click', () => {
      if (!mobileDrawer.hidden) return closeMobileMenu(true);
      mobileDrawer.hidden = false;
      mobileMenuToggle.setAttribute('aria-expanded', 'true');
      mobileMenuToggle.setAttribute('aria-label', 'Close navigation');
      document.body.classList.add('menu-open');
      mobileDrawer.querySelector('a').focus();
    });

    document.addEventListener('keydown', event => {
      if (mobileDrawer.hidden) return;
      if (event.key === 'Escape') closeMobileMenu(true);
      if (event.key === 'Tab') {
        const lastLink = mobileDrawer.querySelector('.btn');
        if (event.shiftKey && document.activeElement === mobileMenuToggle) {
          event.preventDefault();
          lastLink.focus();
        } else if (!event.shiftKey && document.activeElement === lastLink) {
          event.preventDefault();
          mobileMenuToggle.focus();
        }
      }
    });
    desktopBreakpoint.addEventListener('change', event => {
      if (event.matches) closeMobileMenu();
    });

    function openDownloadInfo() {
      document.getElementById('downloadInfo').showModal();
    }
  </script>
</body>

</html>
