<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BizzDeal — Your Success Is Our Deal | Local Business & Referral Network</title>
  <meta name="description" content="BizzDeal is Srikakulam's premier local business and referral network. Connect with trusted entrepreneurs, exchange formal referral slips, advertise with Featured Stores, promote with Bizz Videos using social links, and earn BizzCoins.">
  <link rel="icon" type="image/png" href="/assets/icon-only1.png">

  <!-- Modern Typography: Outfit for headlines, Inter for interface -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: light;
      --bg-main: #fcfbf8;
      --bg-surface: #ffffff;
      --text-main: #182d43;
      --text-muted: #5c6b78;
      --text-dim: #687683;
      --primary-600: #1763e8;
      --primary-500: #1763e8;
      --cyan-400: #1763e8;
      --emerald-400: #257459;
      --amber-400: #916119;
      --purple-400: #7554ac;
      --rose-400: #af4f68;
      --border-subtle: #e2e6e9;
      --font-display: 'Outfit', sans-serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 104px; }
    body { font-family: var(--font-body); background: var(--bg-main); color: var(--text-main); line-height: 1.65; -webkit-font-smoothing: antialiased; }
    body.menu-open { overflow: hidden; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; }
    a, button { -webkit-tap-highlight-color: transparent; }
    :focus-visible { outline: 3px solid var(--primary-600); outline-offset: 5px; }
    [hidden] { display: none !important; }
    ::selection { background: #dce8ff; color: #182d43; }
    .container { width: min(100% - 96px, 1200px); margin-inline: auto; }
    .ui-icon { width: 24px; height: 24px; flex-shrink: 0; vertical-align: middle; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .icon-definitions { position: absolute; width: 0; height: 0; overflow: hidden; }
    .skip-link { position: fixed; z-index: 1100; top: 12px; left: 16px; background: white; color: var(--primary-600); padding: 10px 20px; border-radius: 8px; transform: translateY(-160%); }
    .skip-link:focus { transform: translateY(0); }

    /* Navigation */
    .site-header { position: sticky; top: 0; z-index: 100; background: rgba(252, 251, 248, .96); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border-subtle); }
    .nav-inner { height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand-wrap { display: inline-flex; align-items: center; gap: 9px; flex-shrink: 0; }
    .brand-logo-icon { width: auto; height: 39px; object-fit: contain; }
    .brand-logo-text { width: auto; height: 36px; object-fit: contain; }
    .nav-links { display: flex; list-style: none; align-items: center; gap: 25px; }
    .nav-link { font-size: 12px; font-weight: 500; color: #4d5d6e; transition: color .2s; }
    .nav-link:hover, .footer-links a:hover { color: var(--primary-600); }
    .nav-actions { display: flex; align-items: center; gap: 12px; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 44px; padding: 11px 20px; border-radius: 8px; border: 1px solid transparent; font-size: 13px; font-weight: 600; line-height: 1.45; transition: background .2s, box-shadow .2s, transform .2s; }
    .btn-primary { color: white; background: var(--primary-600); box-shadow: 0 4px 8px #1763e815; }
    .btn-primary:hover { background: #0b4fc8; box-shadow: 0 6px 14px #1763e825; transform: translateY(-2px); }
    .btn-ghost { background: white; border-color: #d3dae0; }
    .btn-ghost:hover { background: #f1f5fb; border-color: #a9bbd1; }
    .btn-emerald { background: #245c49; color: white; }
    .btn-emerald:hover { background: #194a39; }
    .btn-lg { min-height: 52px; padding: 15px 23px; font-size: 14px; }
    .btn .ui-icon { width: 18px; height: 18px; }
    .mobile-menu-btn { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; border: 1px solid var(--border-subtle); border-radius: 8px; background: white; }
    .mobile-drawer { position: fixed; z-index: 99; inset: 88px 0 0; overflow-y: auto; padding: 28px 24px; background: var(--bg-main); }
    .mobile-nav-link { display: block; padding: 17px 0; border-bottom: 1px solid var(--border-subtle); font-size: 18px; }

    /* Hero: an illustrated neighborhood network, with no device preview. */
    .hero-section { padding: 76px 0 0; overflow: hidden; }
    .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
    .hero-badge { display: inline-flex; gap: 9px; align-items: center; font-size: 11px; font-weight: 600; color: #3f6553; padding: 6px 11px; border-radius: 6px; background: #edf2e7; margin-bottom: 23px; }
    .badge-dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: #4e8b65; }
    .hero-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(42px, 4.7vw, 64px); line-height: 1.08; letter-spacing: -.045em; margin-bottom: 25px; }
    .hero-title .hero-title-intro { display: block; }
    .hero-title .hero-title-location { display: block; font-size: .7em; letter-spacing: -.035em; margin: 9px 0; }
    .gradient-text-blue, .gradient-text-gold { color: var(--primary-600); }
    .hero-desc { max-width: 560px; color: var(--text-muted); font-size: 14px; line-height: 1.85; margin-bottom: 29px; }
    .hero-cta-group { display: flex; flex-wrap: wrap; gap: 12px; }
    .hero-visual { position: relative; min-width: 0; }
    .network-art { display: block; width: 100%; height: auto; overflow: visible; }
    .network-art text { font-family: var(--font-body); }
    .hero-visual-caption { display: flex; align-items: center; justify-content: center; gap: 9px; font-size: 11px; letter-spacing: .025em; color: #687b69; margin-top: -7px; }
    .hero-visual-caption .ui-icon { width: 16px; height: 16px; }
    .hero-highlights { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; padding: 31px 0; margin-top: 65px; border-top: 1px solid #dadfdc; border-bottom: 1px solid #dadfdc; }
    .highlight-item { padding-left: 28px; border-left: 1px solid #dadfdc; }
    .highlight-item:first-child { padding-left: 0; border-left: 0; }
    .highlight-val { font-family: var(--font-display); font-size: 28px; font-weight: 500; line-height: 1.2; letter-spacing: -.025em; margin-bottom: 7px; }
    .highlight-lbl { color: var(--text-muted); font-size: 11px; line-height: 1.6; }

    /* Shared section rhythm and typography */
    .dual-section, .features-section, .community-section, .steps-section, .categories-section, .faq-section { padding: 94px 0; }
    .section-head { text-align: center; max-width: 720px; margin: 0 auto 40px; }
    .section-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .15em; color: var(--primary-600); margin-bottom: 16px; }
    .section-eyebrow::before { content: ''; width: 18px; height: 2px; background: currentColor; }
    .section-title { font-family: var(--font-display); font-size: clamp(30px, 3vw, 42px); font-weight: 500; letter-spacing: -.035em; line-height: 1.15; margin-bottom: 16px; text-wrap: balance; }
    .section-subtitle { font-size: 14px; color: var(--text-muted); line-height: 1.8; }
    .benefit-title, .feature-name, .community-card-title, .col-title { font-family: var(--font-display); font-size: 20px; font-weight: 500; letter-spacing: -.02em; line-height: 1.35; }
    .benefit-text, .feature-desc, .community-card-desc { font-size: 13px; line-height: 1.85; color: var(--text-muted); }

    /* Business and shopper benefits */
    .dual-section { background: var(--bg-main); }
    .tab-switch-wrapper { display: flex; justify-content: center; margin-bottom: 36px; }
    .tab-switch-container { display: inline-flex; padding: 5px; gap: 4px; background: #efefec; border: 1px solid #e5e5df; border-radius: 10px; }
    .tab-btn { display: flex; align-items: center; justify-content: center; gap: 9px; border-radius: 7px; padding: 12px 22px; font-size: 12px; font-weight: 500; color: var(--text-muted); transition: color .2s, background .2s; }
    .tab-btn .ui-icon { width: 18px; height: 18px; }
    .tab-btn.active { background: white; color: var(--primary-600); box-shadow: 0 2px 5px #182d430e; }
    .dual-cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .benefit-card { background: white; border: 1px solid var(--border-subtle); border-radius: 12px; padding: 28px; transition: border-color .2s, transform .2s; }
    .benefit-card:hover { border-color: #a9bdd7; transform: translateY(-3px); }
    .benefit-icon, .feature-icon-circle, .community-card-icon { width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: #edf3fd; color: #2668cd; margin-bottom: 23px; }
    .amber .benefit-icon, .amber .community-card-icon { background: #fcf1df; color: #966826; }
    .emerald .benefit-icon, .green .community-card-icon { background: #edf4e8; color: #427748; }
    .purple .benefit-icon { background: #f2edfa; color: #7d61ad; }
    .rose .benefit-icon { background: #fceef0; color: #b25874; }
    .benefit-title { margin-bottom: 10px; }

    /* Feature cards */
    .features-section { background: #f0f4f8; border-block: 1px solid #e6ebef; }
    .features-section .section-head { display: grid; grid-template-columns: 1.1fr 1fr; column-gap: 90px; max-width: none; text-align: left; align-items: center; }
    .features-section .section-eyebrow { grid-column: 1 / -1; }
    .features-section .section-title { margin-bottom: 0; text-wrap: initial; }
    .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .feature-box { display: flex; flex-direction: column; padding: 28px; border: 1px solid #e0e6ed; background: white; border-radius: 12px; }
    .feature-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 24px; }
    .feature-icon-circle { margin: 0; }
    .feature-badge { font-size: 9px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; border-radius: 4px; padding: 4px 8px; color: #356aa8; background: #eef4fc; }
    .feature-name { margin-bottom: 11px; }
    .feature-desc { flex-grow: 1; margin-bottom: 22px; }
    .feature-highlight-bar { display: flex; gap: 8px; padding-top: 15px; border-top: 1px solid #e9ecef; font-size: 10px; font-weight: 500; color: #4c5e6f; }
    .feature-highlight-bar .icon { color: #39735e; }

    /* Conversations and community */
    .community-section { background: white; }
    .community-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .community-card { padding: 32px; border-radius: 12px; background: #f0f4fc; }
    .community-card.green { background: #f0f4e9; }
    .community-card.amber { background: #fcf3e6; }
    .community-card-icon { background: white; }
    .community-card-title { margin-bottom: 14px; font-size: 23px; }
    .community-card-desc { margin-bottom: 24px; }
    .community-perks-list { display: flex; flex-direction: column; gap: 12px; list-style: none; border-top: 1px solid #182d431a; padding-top: 21px; color: #536575; font-size: 11px; }
    .community-perks-list li { display: flex; align-items: baseline; gap: 9px; }
    .community-perks-list .dot { flex-shrink: 0; width: 4px; height: 4px; border-radius: 50%; background: currentColor; }

    /* Getting started */
    .steps-section { background: #fcfbf8; border-block: 1px solid #e8e8e2; }
    .steps-split { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .steps-column { padding: 34px; background: white; border: 1px solid #e3e6e7; border-radius: 12px; }
    .steps-col-head { display: flex; align-items: center; gap: 12px; padding-bottom: 23px; border-bottom: 1px solid #e6eaec; margin-bottom: 28px; }
    .col-icon { color: var(--primary-600); }
    .step-list { display: flex; flex-direction: column; gap: 28px; }
    .step-item { display: flex; gap: 18px; align-items: flex-start; position: relative; }
    .step-item:not(:last-child)::after { content: ''; position: absolute; left: 16px; top: 41px; bottom: -19px; border-left: 1px dashed #d8dfe6; }
    .step-number { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--primary-600); background: #edf3fd; border-radius: 50%; font-size: 12px; font-weight: 600; }
    .steps-column:last-child .step-number { background: #f0f4e9; color: #4b7351; }
    .step-details h4 { font-family: var(--font-display); font-size: 16px; font-weight: 500; line-height: 1.45; margin-bottom: 5px; }
    .step-details p { font-size: 12px; line-height: 1.8; color: var(--text-muted); }

    /* Local commerce and app invitation */
    .categories-section { background: white; }
    .categories-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 1000px; margin: 0 auto 48px; }
    .category-chip { display: inline-flex; align-items: center; gap: 10px; padding: 13px 18px; background: #fafbf9; border: 1px solid #e4e8e3; border-radius: 8px; font-size: 12px; color: #4c5f58; }
    .category-chip .ui-icon { width: 19px; height: 19px; }
    .local-trust-card { display: flex; align-items: center; justify-content: space-between; gap: 32px; background: #f0f4e9; border-radius: 12px; padding: 30px 34px; }
    .trust-text h3 { font-family: var(--font-display); font-size: 21px; font-weight: 500; letter-spacing: -.02em; margin-bottom: 5px; }
    .trust-text p { max-width: 740px; color: #5a6c5c; font-size: 12px; line-height: 1.8; }
    .download-section { padding: 0 0 94px; background: white; }
    .download-card { display: grid; grid-template-columns: 1.5fr 1fr; gap: 60px; align-items: center; background: #edf3fe; border: 1px solid #dce6f7; border-radius: 16px; padding: 60px; }
    .download-content h2 { max-width: 550px; font-family: var(--font-display); font-size: clamp(32px, 3.4vw, 44px); font-weight: 500; letter-spacing: -.035em; line-height: 1.15; margin-bottom: 19px; }
    .download-content p { font-size: 13px; line-height: 1.85; color: var(--text-muted); margin-bottom: 24px; }
    .store-badge { display: inline-flex; align-items: center; gap: 12px; padding: 11px 20px; background: #182d43; color: white; border: 1px solid transparent; border-radius: 8px; text-align: left; }
    .store-badge:hover { background: #234666; }
    .store-icon .ui-icon { width: 27px; height: 27px; }
    .store-text-sub { display: block; font-size: 9px; text-transform: uppercase; letter-spacing: .07em; color: #d5e0ec; }
    .store-text-main { display: block; font-family: var(--font-display); font-size: 17px; }
    .download-emblem { text-align: center; position: relative; padding: 27px; }
    .download-emblem-mark { display: grid; place-items: center; width: 154px; height: 154px; border-radius: 24px; margin: 0 auto 20px; background: white; border: 1px solid #dce6f7; box-shadow: 0 16px 32px #254e9810; transform: none; }
    .download-emblem-mark img { width: 118px; height: 118px; object-fit: contain; transform: none; border-radius: 8px; }
    .download-emblem strong { display: block; font-family: var(--font-display); font-size: 20px; font-weight: 500; color: var(--text-main); margin-bottom: 6px; }
    .download-emblem p { color: #5c6d82; font-size: 12px; line-height: 1.6; max-width: 240px; margin: 0 auto; }
    .download-dialog { width: min(460px, calc(100% - 40px)); margin: auto; padding: 32px; border: 1px solid #dce6f7; border-radius: 16px; color: var(--text-main); background: white; box-shadow: 0 20px 70px #182d4326; }
    .download-dialog::backdrop { background: #182d4366; }
    .download-dialog h2 { font-family: var(--font-display); font-weight: 500; font-size: 28px; margin-bottom: 12px; }
    .download-dialog p { font-size: 14px; color: var(--text-muted); margin-bottom: 24px; }
    .dialog-actions { display: flex; flex-wrap: wrap; gap: 12px; }

    /* Questions and footer */
    .faq-section { background: var(--bg-main); border-top: 1px solid #e8e8e2; }
    .faq-section > .container { display: grid; grid-template-columns: .8fr 1.4fr; gap: 90px; align-items: start; }
    .faq-section .section-head { text-align: left; margin: 0; }
    .faq-section .section-title { text-wrap: initial; }
    .faq-list { border-top: 1px solid #dce1e4; }
    .faq-item { border-bottom: 1px solid #dce1e4; }
    .faq-question { display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; gap: 20px; padding: 22px 0; font-size: 13px; font-weight: 500; line-height: 1.65; }
    .faq-question:hover { color: var(--primary-600); }
    .faq-icon { display: flex; justify-content: center; align-items: center; flex-shrink: 0; width: 25px; height: 25px; border-radius: 50%; border: 1px solid #d6dee5; font-size: 19px; font-weight: 400; color: #55758f; transition: transform .2s; }
    .faq-item.open .faq-icon { transform: rotate(45deg); color: var(--primary-600); }
    .faq-answer { font-size: 12px; line-height: 1.9; padding: 0 34px 23px 0; color: var(--text-muted); }
    .site-footer { padding: 60px 0 25px; background: #f3f3ef; border-top: 1px solid #e2e5df; }
    .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 50px; margin-bottom: 50px; }
    .footer-brand p { font-size: 12px; line-height: 1.85; color: var(--text-muted); margin: 19px 0 14px; max-width: 290px; }
    .footer-slogan { color: var(--primary-600); font-family: var(--font-display); font-size: 14px; }
    .footer-col h4 { font-size: 12px; font-weight: 600; margin-bottom: 20px; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 11px; line-height: 1.8; color: var(--text-muted); }
    .footer-links .ui-icon { width: 15px; height: 15px; }
    .footer-bottom { display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid #dce1da; padding-top: 23px; font-size: 10px; color: var(--text-muted); }

    @media (min-width: 1101px) { .mobile-drawer { display: none; } }
    @media (max-width: 1100px) {
      .nav-links { display: none; }
      .mobile-menu-btn { display: inline-flex; }
      .hero-grid { gap: 24px; }
      .hero-title { font-size: 49px; }
      .hero-section { padding-top: 60px; }
      .benefit-card, .feature-box, .community-card { padding: 24px; }
      .features-section .section-head { column-gap: 45px; }
      .faq-section > .container { gap: 48px; }
      .footer-grid { gap: 30px; }
    }
    @media (max-width: 800px) {
      .container { width: calc(100% - 48px); }
      .hero-grid { grid-template-columns: 1fr; gap: 20px; }
      .hero-text-col { max-width: 620px; margin: auto; text-align: center; }
      .hero-title { font-size: clamp(43px, 7vw, 62px); }
      .hero-desc { margin-inline: auto; }
      .hero-cta-group { justify-content: center; }
      .hero-visual { max-width: 480px; width: 100%; margin: 0 auto; }
      .hero-highlights { margin-top: 36px; gap: 16px; }
      .highlight-item { padding-left: 16px; }
      .highlight-val { font-size: 24px; }
      .dual-section, .features-section, .community-section, .steps-section, .categories-section, .faq-section { padding: 64px 0; }
      .dual-cards-grid, .features-grid { grid-template-columns: repeat(2, 1fr); }
      .community-grid { grid-template-columns: 1fr; }
      .community-card { padding: 30px; }
      .features-section .section-head { grid-template-columns: 1fr; }
      .features-section .section-title { margin-bottom: 16px; }
      .steps-split { grid-template-columns: 1fr; }
      .local-trust-card { flex-direction: column; text-align: center; }
      .download-section { padding-bottom: 64px; }
      .download-card { padding: 36px; grid-template-columns: 1.5fr 1fr; gap: 22px; }
      .download-emblem { padding: 0; }
      .download-emblem-mark { width: 120px; height: 120px; }
      .download-emblem-mark img { width: 86px; height: 86px; }
      .faq-section > .container { grid-template-columns: 1fr; gap: 25px; }
      .faq-section .section-head { max-width: 500px; }
      .footer-grid { grid-template-columns: repeat(2, 1fr); gap: 36px; }
    }
    @media (max-width: 520px) {
      html { scroll-padding-top: 88px; }
      .container { width: calc(100% - 40px); }
      .nav-inner { height: 74px; gap: 8px; }
      .brand-logo-icon { height: 29px; }
      .brand-logo-text { height: 27px; }
      .brand-wrap { gap: 6px; }
      .nav-actions { gap: 8px; }
      .nav-actions > .btn { padding: 9px 11px; font-size: 10px; }
      .mobile-menu-btn { width: 40px; }
      .mobile-drawer { top: 74px; }
      .hero-section { padding-top: 40px; }
      .hero-badge { font-size: 9px; margin-bottom: 22px; }
      .hero-title { font-size: clamp(37px, 10vw, 49px); }
      .hero-desc { font-size: 13px; line-height: 1.8; }
      .hero-cta-group { gap: 10px; }
      .hero-cta-group .btn { font-size: 12px; padding: 13px 14px; }
      .hero-visual { margin-top: 8px; }
      .hero-visual-caption { font-size: 10px; }
      .hero-highlights { grid-template-columns: repeat(2, 1fr); gap: 25px 18px; padding: 25px 0; }
      .highlight-item:nth-child(3) { padding-left: 0; border: 0; }
      .highlight-lbl { font-size: 10px; }
      .section-head { margin-bottom: 30px; }
      .section-eyebrow { font-size: 9px; letter-spacing: .1em; }
      .section-subtitle { font-size: 13px; }
      .tab-switch-container { width: 100%; }
      .tab-btn { flex: 1; flex-direction: column; gap: 6px; padding: 10px 8px; font-size: 10px; line-height: 1.6; }
      .dual-cards-grid, .features-grid { grid-template-columns: 1fr; gap: 14px; }
      .benefit-card, .feature-box { padding: 26px; }
      .benefit-title, .feature-name { font-size: 21px; }
      .benefit-text, .feature-desc { font-size: 13px; }
